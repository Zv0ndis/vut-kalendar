# Copy the keys you need into the repo-root .env (chmod 600). Never commit it.
# Comments go on their own line like these: systemd's EnvironmentFile would make a trailing "# ..." part of the value.

# Required. Set the token with deploy/set-token.sh (hidden input).
DISCORD_BOT_TOKEN=
# Required. Your own Discord user ID (Developer Mode -> right click yourself -> Copy User ID).
DISCORD_USER_ID=

# Extra calendars in the digest by name, comma-separated; "primary" is the main calendar. Default: school calendar only.
DIGEST_CALENDARS=
# Quiet hours in Prague time; alerts other than registration-opens, seats and reminders are held until QUIET_TO.
QUIET_FROM=22
QUIET_TO=8

# Optional AI chat (/ai and plain DMs). Without the key the bot works, chat just says it is disabled.
ANTHROPIC_API_KEY=
ZHELPER_MODEL=claude-haiku-5-5
# Daily spend cap in USD; chat refuses after it.
ZHELPER_DAILY_USD=1.00
# CALENDAR_NAME, MOODLE_ICS_URL, ROOM_URL, SKIP_TITLES, VUT_TOKEN_FILE belong to the core, see .env.example
