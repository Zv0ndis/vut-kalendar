# Copy to .env (server part) - or put the same values into GitHub (Settings > Secrets and variables > Actions) for the calendar part.
# One KEY=value per line, no quotes, no spaces around =, comments only on their own lines. .env is never committed.

# ---------- calendar sync (the core) ----------
# VUT login for Studis (the same you use at vut.cz). Needed: Studis is scraped for exam registrations, assignment deadlines and course items.
VUT_USER=
VUT_PASS=
# Name of the Google calendar the tool creates and owns (default Škola). Events in other calendars are never touched.
#CALENDAR_NAME=Škola
# Optional: Moodle > Calendar > Export > "Get calendar URL" (deadlines from Moodle).
#MOODLE_ICS_URL=
# Optional: official VUT API (https://id.vut.cz/my-account/client/, grant type client_credentials). Faster and sturdier than scraping;
# without it everything is scraped from Studis.
#VUT_API_CLIENT_ID=
#VUT_API_SECRET=
# Optional: a regex of calendar titles you do not want at all, e.g. ^ABC \(termín\)$
#SKIP_TITLES=
# Optional: link to a room page put into the event description ({} = room, e.g. D105). Default is the FIT room page for FIT rooms (B/D105);
# write off to switch the links off.
#ROOM_URL=

# ---------- Discord bot (optional, needs an always-on server) ----------
DISCORD_BOT_TOKEN=
# Your Discord user ID (Settings > Advanced > Developer mode, then right click on yourself > Copy User ID). The bot answers only you.
DISCORD_USER_ID=
# Extra calendars in the daily digest, by name, comma separated; "primary" = your main calendar. Default: only the school calendar.
#DIGEST_CALENDARS=
# Quiet hours for alerts: nothing but registration openings, free seats and reminders from QUIET_FROM to QUIET_TO (Prague time, default 22 and 8).
#QUIET_FROM=22
#QUIET_TO=8

# ---------- AI chat inside the bot (optional) ----------
# Without a key the bot works as before, it just has no chat agent (and plain messages get "AI není nastavené").
#ANTHROPIC_API_KEY=
# Daily spend cap in USD (default 1.00); the agent stops for the day when it is reached.
#ZHELPER_DAILY_USD=1.00
#ZHELPER_MODEL=claude-haiku-5-5
